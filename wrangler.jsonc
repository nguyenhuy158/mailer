{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mailer",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // No routes, and workers_dev is off: this Worker is reachable only via a
  // Service Binding from other Workers in this account, never the public web.
  "workers_dev": false,
  "vars": {
    "DEFAULT_FROM": "noreply@huyab.click"
  }
}
