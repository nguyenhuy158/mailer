{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mailer",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // No routes, and workers_dev is off: this Worker is reachable only via a
  // Service Binding from other Workers in this account, never the public web.
  "workers_dev": false,
  "vars": {
    "DEFAULT_FROM": "noreply@huyab.click"
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Shared voi sso/shopee-tracker, hence the mailer_ table prefix.
      "database_name": "db",
      "database_id": "6eb9cfce-f6f3-4476-8e46-7c8e954d93c1"
    }
  ]
}
