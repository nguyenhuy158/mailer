{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mailer",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Chi bat mot custom domain cho trang xem log (GET /), khong bat workers_dev:
  // /send van chi goi duoc qua Service Binding + Bearer INTERNAL_API_KEY,
  // route nay khong lam ho yeu di, no chi cho / co the vao tu ngoai.
  "workers_dev": false,
  "routes": [{ "pattern": "mail.huyab.click", "custom_domain": true }],
  "vars": {
    "DEFAULT_FROM": "noreply@huyab.click",
    "SSO_ISSUER": "https://auth.huyab.click",
    // Duy nhat email nay duoc xem trang log; ai khac dang nhap SSO cung bi 403.
    "ADMIN_EMAIL": "ntqhuy2k2@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Shared voi sso/shopee-tracker, hence the mailer_ table prefix.
      "database_name": "db",
      "database_id": "6eb9cfce-f6f3-4476-8e46-7c8e954d93c1"
    }
  ]
}
